# Terraform working state and caches - regenerated locally/in CI by `terraform init`, never committed.
**/.terraform/
.terraform/

# State files contain secrets in clear text (see modules/keyvault/main.tf) and are per-environment remote state
# anyway (see envs/*/backend.tf, scripts/bootstrap-state.ps1). Never commit any local copy.
*.tfstate
*.tfstate.*

# Crash logs.
crash.log
crash.*.log

# Per-environment tfvars ARE committed (envs/*/*.tfvars: dev.tfvars, nonprod.tfvars, prod.tfvars - no secrets in
# them, see each file's header comment). Only auto-loaded, usually-local override files are ignored.
*.auto.tfvars
*.auto.tfvars.json

# terraform.tfvars(.json) is the conventional "local scratch overrides" filename; this repo always passes
# -var-file=<env>.tfvars explicitly, so a stray terraform.tfvars would only ever be an accidental local file.
terraform.tfvars
terraform.tfvars.json

# NOTE: envs/*/backend.hcl (generated by scripts/bootstrap-state.ps1 from backend.hcl.example) is NOT ignored.
# It holds no secrets (just the state resource group/storage account/container/key names) and CI needs it
# committed to run `terraform init -backend-config=backend.hcl` (see bootstrap-state.ps1's own "commit it" note
# and .github/workflows/terraform-*.yml).
#
# NOTE: .terraform.lock.hcl (the provider dependency lock file) is NOT ignored either - it is committed per
# environment so CI and every operator resolve the exact same provider versions.

# Editor/OS noise.
.DS_Store
